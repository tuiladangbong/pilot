{
  "name": "pilot",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Pilot - Extensible AI Resource Hub",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply pilot-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pilot-db --remote",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "curate:dry-run": "node scripts/auto-curate/index.mjs --dry-run",
    "curate:live": "node scripts/auto-curate/index.mjs --publish"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
